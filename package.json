{
  "name": "pc-build-advisor-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive PC compatibility advisor that runs as an MCP App in ChatGPT.",
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && node --watch server.js",
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke-test.js",
    "check": "npm test && npm run build && npm run smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
